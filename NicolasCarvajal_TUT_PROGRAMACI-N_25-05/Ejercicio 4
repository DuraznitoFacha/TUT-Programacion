Proceso gastos_semanales
	Definir gastos Como Real Dimension 7
	Definir i Como Entero
	Definir suma, promedio Como Real
	
	suma <- 0
	
	Para i <- 1 Hasta 7 Hacer
		Escribir "Ingrese el gasto del dia " i ":"
		Leer gastos[i]
		suma <- suma + gastos[i]
	FinPara
	
	promedio <- suma / 7
	Escribir "Promedio de gasto diario: $" promedio
	Escribir "Dias que superaron el promedio:"
	
	Para i <- 1 Hasta 7 Hacer
		Si gastos[i] > promedio Entonces
			Escribir "Dia " i ": $" gastos[i]
		FinSi
	FinPara
	
FinProceso
