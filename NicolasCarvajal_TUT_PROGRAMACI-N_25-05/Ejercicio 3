Proceso control_acceso
	Definir estatura Como Real
	Definir vip Como Caracter
	Definir autorizado Como Logico
	
	Escribir "=== CONTROL DE ACCESO ==="
	Escribir "Ingrese su estatura (en metros):"
	Leer estatura
	Escribir "¿Posee pase VIP? (S/N):"
	Leer vip
	
	autorizado <- (estatura > 1.50) Y (vip = "S" O vip = "s")
	
	Escribir "Acceso autorizado: " autorizado
	
FinProceso
